---
import * as Icons from '@/enums/icons.enum.js'
import * as Ids from '../_scripts/shared/ids.enum.js'
import * as Styles from '../_styles/styles.enum.js'
import * as Constant from '../_scripts/shared/constant.enum.js'
---
<div id={Ids.DecodeContainer}>
	<label for={Ids.Decode}>Decode:</label>
	<textarea
		br:as="textfield"
		id={Ids.Decode}
		placeholder="Type your decoded url here ..."
		data-text-wrap={Constant.DEFAULT_TEXT_WRAP? '' : undefined}>{
		Constant.DEFAULT_DECODED_TEXT
	}</textarea>
</div>
<div id={Ids.Slider} class={Styles.Slider}>
	<br-icon set:html={Icons.ReOrderVertical}/>
</div>
<div>
	<label for={Ids.Encode}>Encode:</label>
	<textarea
		br:as="textfield"
		id={Ids.Encode}
		placeholder="Type your encoded url here ..."
		data-text-wrap={Constant.DEFAULT_TEXT_WRAP? '' : undefined}>{
		Constant.DEFAULT_ENCODED_TEXT
	}</textarea>
</div>