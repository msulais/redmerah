---
import * as Icons from '@/enums/icons.enum.js'
import * as Constant from '../_scripts/shared/constant.enum.js'
import * as Ids from '../_scripts/shared/ids.enum.js'
---
<ol id={Ids.List}>
	{Constant.DEFAULT_VIBRATION_PATTERN.map(v =>
		<li>{v}</li>
	)}
</ol>
<ul>
	<li><button
		br:command-for={Ids.EditDialog}
		br:variant="icon tonal"
		br:tooltip="Edit vibration"
		aria-label="Edit vibration">
		<br-icon set:html={Icons.Edit}/>
	</button></li>
	<li><button br:variant="filled" id={Ids.Vibrate}>
		<br-icon set:html={Icons.PlayFilled}/>
		Vibrate
	</button></li>
	<li><button br:variant="filled" id={Ids.Stop}>
		<br-icon set:html={Icons.PauseFilled}/>
		Stop
	</button></li>
</ul>

<br-dialog
	id={Ids.EditDialog}
	style="width:32rem"
	br:manual>
	<span slot="title">Vibration Pattern</span>
	<textarea
		rows="5"
		br:as="textfield"
		placeholder={Constant.DEFAULT_VIBRATION_PATTERN.join(', ')}
		id={Ids.Input}>{
		Constant.DEFAULT_VIBRATION_PATTERN.join(', ')
	}</textarea>

	<button
		slot="footer"
		br:command-for={Ids.EditDialog}
		br:variant="tonal">
		Cancel
	</button>
	<button
		slot="footer"
		id={Ids.Save}
		br:command-for={Ids.EditDialog}
		br:variant="filled">
		Save
	</button>
</br-dialog>