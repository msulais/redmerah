---
import * as Icons from '@/enums/icons.enum.js'
import * as Ids from '../_scripts/shared/ids.enum.js'
import * as Pages from '../_scripts/shared/pages.enum.js'
---
<br-navigation slot="left-sidebar" id={Ids.Navigation}>
	<br-focusgroup br:direction="vertical">
		<button
			aria-label="Toggle navigation"
			br:tooltip="Toggle navigation"
			br:command-for={Ids.Navigation}>
			<br-icon set:html={Icons.LineHorizontal3}/>
		</button>
		<a
			br:as="navigationitem"
			href={`?page=${Pages.String}`}
			br:query={`page=${Pages.String}|none`}
			br:label="String">
			<br-icon set:html={Icons.TextNumberFormat}/>
		</a>
		<a
			br:as="navigationitem"
			href={`?page=${Pages.Words}`}
			br:query={`page=${Pages.Words}`}
			br:label="Words">
			<br-icon set:html={Icons.CodeText}/>
		</a>
		<a
			br:as="navigationitem"
			href={`?page=${Pages.Number}`}
			br:query={`page=${Pages.Number}`}
			br:label="Number">
			<br-icon set:html={Icons.NumberRow}/>
		</a>
		<a
			br:as="navigationitem"
			href={`?page=${Pages.Colors}`}
			br:query={`page=${Pages.Colors}`}
			br:label="Colors">
			<br-icon set:html={Icons.Color}/>
		</a>
		<a
			br:as="navigationitem"
			href={`?page=${Pages.Selection}`}
			br:query={`page=${Pages.Selection}`}
			br:label="Selection">
			<br-icon set:html={Icons.TextBulletListSquare}/>
		</a>
		<a
			br:as="navigationitem"
			href={`?page=${Pages.Teams}`}
			br:query={`page=${Pages.Teams}`}
			br:label="Teams">
			<br-icon set:html={Icons.People}/>
		</a>
	</br-focusgroup>
</br-navigation>