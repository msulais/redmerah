---
import * as Icons from '@/enums/icons.enum.js'
import * as Ids from '../_scripts/shared/ids.enum.js'
import * as Pages from '../_scripts/shared/pages.enum.js'
import * as Styles from '../_styles/styles.enum.js'
import * as Constant from '../_scripts/shared/constant.enum.js'
---

<br-if
	br:query={`page=${Pages.String}|none`}
	br:animation-for={Ids.PageString}
	br:animation-start-duration="500"
	br:animation-start-keyframes={JSON.stringify({
		opacity: [0, 1],
		scale: [.9, 1]
	})}>
	<div class={Styles.Page} id={Ids.PageString}>
		<textarea
			class={Styles.OutputText}
			rows="5"
			br:as="textfield"
			id={Ids.PageStringOutput}>{
			Constant.DEFAULT_STRING_OUTPUT
		}</textarea>
		<div class={Styles.Options}>
			<div>
				<button
					br:variant="filled"
					id={Ids.PageStringGenerate}>
					<br-icon set:html={Icons.ArrowSync}/>
					<span>Generate</span>
				</button>
				<button
					br:variant="tonal"
					id={Ids.PageStringCopy}>
					<br-icon set:html={Icons.Copy}/>
					Copy
				</button>
			</div>
			<details open>
				<summary>Options</summary>
				<ul>
					<li>
						<label
							for={Ids.PageStringLength}
							style="margin-bottom:.125rem;">
							Length
						</label>
						<input
							id={Ids.PageStringLength}
							min="1"
							br:as="textfield"
							type="number"
							value={Constant.DEFAULT_STRING_LENGTH}
						/>
					</li>
					<li style="margin-top:.5rem">
						<label
							for={Ids.PageStringCustom}
							style="margin-bottom:.125rem;">
							Custom characters
						</label>
						<input
							br:as="textfield"
							type="text"
							id={Ids.PageStringCustom}
							value={Constant.DEFAULT_STRING_CUSTOM}
						/>
					</li>
					<li style="margin-top:.5rem">
						<label br:as="checkbox">
							<input
								type="checkbox"
								id={Ids.PageStringUpper}
								checked={Constant.DEFAULT_STRING_UPPERCASE}
							/>
							Uppercase (ABCDEF...)
						</label>
					</li>
					<li>
						<label br:as="checkbox">
							<input
								type="checkbox"
								id={Ids.PageStringLower}
								checked={Constant.DEFAULT_STRING_LOWERCASE}
							/>
							Lowercase (abcdef...)
						</label>
					</li>
					<li>
						<label br:as="checkbox">
							<input
								type="checkbox"
								id={Ids.PageStringNumber}
								checked={Constant.DEFAULT_STRING_NUMBERS}
							/>
							Number (123456...)
						</label>
					</li>
					<li>
						<label br:as="checkbox">
							<input
								type="checkbox"
								id={Ids.PageStringSymbol}
								checked={Constant.DEFAULT_STRING_SYMBOLS}
							/>
							Symbols (&^$-+[...)
						</label>
					</li>
				</ul>
			</details>
		</div>
	</div>
</br-if>