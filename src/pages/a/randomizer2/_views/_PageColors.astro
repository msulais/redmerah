---
import * as RandomizerColors from '../_scripts/shared/randomizer-colors.js'
import * as Ids from '../_scripts/shared/ids.enum.js'
import * as Pages from '../_scripts/shared/pages.enum.js'
import * as Icons from '@/enums/icons.enum.js'
import * as Styles from '../_styles/styles.enum.js'
import * as Constant from '../_scripts/shared/constant.enum.js'
import { colorContrastPercentage, hexToRgb, rgbToHsl } from '@/utils/color'

const COLOR_SPACES: [value: RandomizerColors.ColorSpaces, text: string][] = [
	[RandomizerColors.ColorSpaces.HEX, 'HEX'],
	[RandomizerColors.ColorSpaces.RGB, 'RGB'],
	[RandomizerColors.ColorSpaces.HSL, 'HSL'],
]
---

<br-if
	br:query={`page=${Pages.Colors}`}
	br:animation-for={Ids.PageColors}
	br:animation-start-duration="500"
	br:animation-start-keyframes={JSON.stringify({
		opacity: [0, 1],
		scale: [.9, 1]
	})}>
	<div class={Styles.Page} id={Ids.PageColors}>
		<ul class={Styles.OutputColors} id={Ids.PageColorsOutput}>
			{Constant.DEFAULT_COLORS_OUTPUT.map(hex => {
				const rgb = hexToRgb(hex)
				const hsl = rgbToHsl(rgb)
				const r = (v: number) => Math.round(v)
				const color = colorContrastPercentage(rgb, {r: 0, g: 0, b: 0}) > 50? '#000' : '#fff'
				return (<li style={{
						backgroundColor: hex,
						color
					}}>
					{hex}<br/>
					{`rgb(${r(rgb.r * 0xff)}, ${r(rgb.g * 0xff)}, ${r(rgb.b * 0xff)})`}<br/>
					{`hsl(${r(hsl.h * 360)}, ${r(hsl.s * 100)}%, ${r(hsl.l * 100)}%)`}
				</li>)
			})}
		</ul>
		<div class={Styles.Options}>
			<div>
				<button
					id={Ids.PageColorsGenerate}
					br:variant="filled">
					<br-icon set:html={Icons.ArrowSync}/>
					<span>Generate</span>
				</button>
				<button
					br:command-for={Ids.PageColorsCopy}
					br:variant="tonal">
					<br-icon set:html={Icons.Copy}/>
					Copy
				</button>
			</div>
			<details open>
				<summary>Options</summary>
				<ul>
					<li>
						<label
							style="margin-bottom:.125rem;"
							for={Ids.PageColorsCount}>
							Count
						</label>
						<input
							min="1"
							type="number"
							br:as="textfield"
							id={Ids.PageColorsCount}
							value={Constant.DEFAULT_COLORS_COUNT}
						/>
					</li>
					<li style="margin-top:.5rem">
						<label
							style="margin-bottom:.125rem;"
							for={Ids.PageColorsSpace}>
							Color space
						</label>
						<select id={Ids.PageColorsSpace}>
							{COLOR_SPACES.map(v => <option
								value={v[0]}
								selected={v[0] === Constant.DEFAULT_COLORS_SPACE}>
								{v[1]}
							</option>)}
						</select>
					</li>
					<li>
						<div
							id={Ids.PageColorsRgb}
							hidden={Constant.DEFAULT_COLORS_SPACE !== RandomizerColors.ColorSpaces.RGB}>
							<fieldset style="margin-top:.5rem">
								<legend>Red</legend>
								<label>
									Min
									<input
										id={Ids.PageColorsRgbRedMin}
										value={Constant.DEFAULT_COLORS_RGB_R_MIN}
										min="0" max="255" type="number" br:as="textfield"
									/>
								</label>
								<label>
									Max
									<input
										id={Ids.PageColorsRgbRedMax}
										value={Constant.DEFAULT_COLORS_RGB_R_MAX}
										min="0" max="255" type="number" br:as="textfield"
									/>
								</label>
							</fieldset>
							<fieldset style="margin-top:.5rem">
								<legend>Green</legend>
								<label>
									Min
									<input
										id={Ids.PageColorsRgbGreenMin}
										value={Constant.DEFAULT_COLORS_RGB_G_MIN}
										min="0" max="255" type="number" br:as="textfield"
									/>
								</label>
								<label>
									Max
									<input
										id={Ids.PageColorsRgbGreenMax}
										value={Constant.DEFAULT_COLORS_RGB_G_MAX}
										min="0" max="255" type="number" br:as="textfield"
									/>
								</label>
							</fieldset>
							<fieldset style="margin-top:.5rem">
								<legend>Blue</legend>
								<label>
									Min
									<input
										id={Ids.PageColorsRgbBlueMin}
										value={Constant.DEFAULT_COLORS_RGB_B_MIN}
										min="0" max="255" type="number" br:as="textfield"
									/>
								</label>
								<label>
									Max
									<input
										id={Ids.PageColorsRgbBlueMax}
										value={Constant.DEFAULT_COLORS_RGB_B_MAX}
										min="0" max="255" type="number" br:as="textfield"
									/>
								</label>
							</fieldset>
						</div>
					</li>
					<li>
						<div
							id={Ids.PageColorsHsl}
							hidden={Constant.DEFAULT_COLORS_SPACE !== RandomizerColors.ColorSpaces.HSL}>
							<fieldset style="margin-top:.5rem">
								<legend>Hue</legend>
								<label>
									Min
									<input
										id={Ids.PageColorsHslHueMin}
										value={Constant.DEFAULT_COLORS_HSL_H_MIN}
										min="0" max="360" type="number" br:as="textfield"
									/>
								</label>
								<label>
									Max
									<input
										id={Ids.PageColorsHslHueMax}
										value={Constant.DEFAULT_COLORS_HSL_H_MAX}
										min="0" max="360" type="number" br:as="textfield"
									/>
								</label>
							</fieldset>
							<fieldset style="margin-top:.5rem">
								<legend>Saturation</legend>
								<label>
									Min
									<input
										id={Ids.PageColorsHslSaturationMin}
										value={Constant.DEFAULT_COLORS_HSL_S_MIN}
										min="0" max="100" type="number" br:as="textfield"
									/>
								</label>
								<label>
									Max
									<input
										id={Ids.PageColorsHslSaturationMax}
										value={Constant.DEFAULT_COLORS_HSL_S_MAX}
										min="0" max="100" type="number" br:as="textfield"
									/>
								</label>
							</fieldset>
							<fieldset style="margin-top:.5rem">
								<legend>Lightness</legend>
								<label>
									Min
									<input
										id={Ids.PageColorsHslLightnessMin}
										value={Constant.DEFAULT_COLORS_HSL_L_MIN}
										min="0" max="100" type="number" br:as="textfield"
									/>
								</label>
								<label>
									Max
									<input
										id={Ids.PageColorsHslLightnessMax}
										value={Constant.DEFAULT_COLORS_HSL_L_MAX}
										min="0" max="100" type="number" br:as="textfield"
									/>
								</label>
							</fieldset>
						</div>
					</li>
					<li>
						<div
							id={Ids.PageColorsHex}
							hidden={Constant.DEFAULT_COLORS_SPACE !== RandomizerColors.ColorSpaces.HEX}>
							<fieldset style="margin-top:.5rem">
								<legend>Hex</legend>
								<label>
									Min
									<input
										id={Ids.PageColorsHexMin}
										value={Constant.DEFAULT_COLORS_HEX_MIN}
										min="0" max="16777215" type="number" br:as="textfield"
									/>
								</label>
								<label>
									Max
									<input
										id={Ids.PageColorsHexMax}
										value={Constant.DEFAULT_COLORS_HEX_MAX}
										min="0" max="16777215" type="number" br:as="textfield"
									/>
								</label>
							</fieldset>
						</div>
					</li>
				</ul>
			</details>
		</div>
	</div>
</br-if>

<br-popover
	id={Ids.PageColorsCopy}
	style="width:6rem">
	<br-focusgroup br:direction="vertical">
		<menu>
			<li><button id={Ids.PageColorsCopyAll}>All</button></li>
			<li><hr/></li>
			<li><button id={Ids.PageColorsCopyHex}>HEX</button></li>
			<li><button id={Ids.PageColorsCopyRgb}>RGB</button></li>
			<li><button id={Ids.PageColorsCopyHsl}>HSL</button></li>
		</menu>
	</br-focusgroup>
</br-popover>