---
import * as InputNames from '../_scripts/shared/input-names.enum.js'
import * as TabValues from '../_scripts/shared/tab-values.enum.js'
import * as Icons from '@/enums/icons.enum.js'
import * as Ids from '../_scripts/shared/ids.enum.js'
import * as Styles from '../_styles/styles.enum.js'
import * as Constant from '../_scripts/shared/constant.enum.js'
---
<div id={Ids.InputContainer}>
	<div id={Ids.InputTabs}>
		<label br:as="tab">
			<input
				type="radio"
				name={InputNames.TabsInput}
				value={TabValues.InputSASS}
				checked={Constant.DEFAULT_TAB_INPUT_VALUE === TabValues.InputSASS}
			/>
			SASS
		</label>
		<label br:as="tab">
			<input
				type="radio"
				name={InputNames.TabsInput}
				value={TabValues.InputSCSS}
				checked={Constant.DEFAULT_TAB_INPUT_VALUE === TabValues.InputSCSS}
			/>
			SCSS
		</label>
	</div>
	<textarea
		br:as="textfield"
		id={Ids.InputSASS}
		placeholder="Type your SASS here ..."
		style={{
			display: Constant.DEFAULT_TAB_INPUT_VALUE === TabValues.InputSASS? null : 'none'
		}}
		data-text-wrap={Constant.DEFAULT_TEXT_WRAP? '' : undefined}>{
		Constant.DEFAULT_SASS_TEXT
	}</textarea>
	<textarea
		br:as="textfield"
		id={Ids.InputSCSS}
		placeholder="Type your SCSS here ..."
		style={{
			display: Constant.DEFAULT_TAB_INPUT_VALUE === TabValues.InputSCSS? null : 'none'
		}}
		data-text-wrap={Constant.DEFAULT_TEXT_WRAP? '' : undefined}>{
		Constant.DEFAULT_SCSS_TEXT
	}</textarea>
</div>
<div id={Ids.Slider} class={Styles.Slider}>
	<br-icon set:html={Icons.ReOrderVertical}/>
</div>
<div>
	<div>
		<label br:as="tab">
			<input
				type="radio"
				name={InputNames.TabsOutput}
				checked
			/>
			CSS
		</label>
	</div>
	<textarea
		br:as="textfield"
		id={Ids.OutputCSS}
		data-text-wrap={Constant.DEFAULT_TEXT_WRAP? '' : undefined}>{
		Constant.DEFAULT_CSS_TEXT
	}</textarea>
</div>