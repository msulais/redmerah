---
import * as Icons from '@/enums/icons.enum.js'
import * as Ids from '../_scripts/shared/ids.enum.js'
import * as Styles from '../_styles/styles.enum.js'
import * as Constant from '../_scripts/shared/constant.enum.js'
---
<div id={Ids.UnescapeContainer}>
	<label for={Ids.Unescape}>Decode:</label>
	<textarea
		br:as="textfield"
		id={Ids.Unescape}
		placeholder="Type your unescaped xml here ..."
		data-text-wrap={Constant.DEFAULT_TEXT_WRAP? '' : undefined}>{
		Constant.DEFAULT_UNESCAPE_XML_TEXT
	}</textarea>
</div>
<div id={Ids.Slider} class={Styles.Slider}>
	<br-icon set:html={Icons.ReOrderVertical}/>
</div>
<div>
	<label for={Ids.Escape}>Encode:</label>
	<textarea
		br:as="textfield"
		id={Ids.Escape}
		placeholder="Type your escaped url here ..."
		data-text-wrap={Constant.DEFAULT_TEXT_WRAP? '' : undefined}>{
		Constant.DEFAULT_ESCAPE_XML_TEXT
	}</textarea>
</div>