---
import * as Icons from '@/enums/icons.enum.js'
import * as Ids from '../_scripts/shared/ids.enum.js'
import * as Pages from '../_scripts/shared/pages.enum.js'
import * as Styles from '../_styles/styles.enum.js'
import * as QrCodes from '../_scripts/shared/qrcode.js'
import * as Constant from '../_scripts/shared/constant.enum.js'

const ERROR_CORRECTION_CODES: [value: QrCodes.ErrorCorrectionLevel, text: string][] = [
	[QrCodes.ErrorCorrectionLevel.Low     , 'Low (~7%)'      ],
	[QrCodes.ErrorCorrectionLevel.Medium  , 'Medium (~15%)'  ],
	[QrCodes.ErrorCorrectionLevel.Quartile, 'Quartile (~25%)'],
	[QrCodes.ErrorCorrectionLevel.High    , 'High (~30%)'    ],
]

const ENCODING_MODES: [value: QrCodes.EncodingMode, text: string][] = [
	[QrCodes.EncodingMode.Auto, 'Auto'],
	[QrCodes.EncodingMode.Alphanumeric, 'Alphanumeric'],
	[QrCodes.EncodingMode.Byte, 'Byte'],
	[QrCodes.EncodingMode.Kanji, 'Kanji'],
	[QrCodes.EncodingMode.Numeric, 'Numeric'],
]
---

<br-if
	br:query={`page=${Pages.Generate}|none`}
	br:animation-for={Ids.PageGenerate}
	br:animation-start-duration="500"
	br:animation-start-keyframes={JSON.stringify({
		opacity: [0, 1],
		scale: [.9, 1]
	})}>
	<div class={[Styles.Page, Styles.PageGenerate].join(' ')} id={Ids.PageGenerate}>
		<div>
			<canvas id={Ids.PageGenerateOutput}></canvas>
			<ul>
				<li><button br:variant="tonal" id={Ids.PageGenerateExportCopy}>Copy</button></li>
				<li><button br:variant="tonal" id={Ids.PageGenerateExportPNG}>PNG</button></li>
				<li><button br:variant="tonal" id={Ids.PageGenerateExportJPEG}>JPEG</button></li>
				<li><button br:variant="tonal" id={Ids.PageGenerateExportSVG}>SVG</button></li>
			</ul>
		</div>
		<div>
			<textarea
				id={Ids.PageGenerateInput}
				rows="5"
				placeholder="Type your data here"
				br:as="textfield">{
				Constant.DEFAULT_DATA
			}</textarea>
			<details open>
				<summary>Options</summary>
				<ul>
					<li>
						<label for={Ids.PageGenerateCorrection}>
							<br-icon set:html={Icons.ErrorCircleSettings}/>
							Error Correction Level
						</label>
						<select id={Ids.PageGenerateCorrection}>
							{ERROR_CORRECTION_CODES.map(v => <option
								value={v[0]}
								selected={Constant.DEFAULT_ERROR_CORRECTION_LEVEL === v[0]}>
								{v[1]}
							</option>)}
						</select>
					</li>
					<li>
						<label for={Ids.PageGenerateEncoding}>
							<br-icon set:html={Icons.Translate}/>
							Encoding Mode
						</label>
						<select id={Ids.PageGenerateEncoding}>
							{ENCODING_MODES.map(v => <option
								value={v[0]}
								selected={Constant.DEFAULT_ENCODING_MODE === v[0]}>
								{v[1]}
							</option>)}
						</select>
					</li>
					<li style="flex-direction: row;">
						<label for={Ids.PageGenerateAutoVersion}>
							<br-icon set:html={Icons.NumberRow}/>
							Auto Version
						</label>
						<input
							br:as="switch"
							type="checkbox"
							id={Ids.PageGenerateAutoVersion}
							checked={Constant.DEFAULT_AUTO_VERSION}
						/>
					</li>
					<li>
						<br-if br:media="(width > 23rem)">
							<label for={Ids.PageGenerateVersion}>
								<br-icon set:html={Icons.NumberRow} style="opacity:0"/>
								Custom Version
							</label>
						</br-if>
						<input
							br:as="textfield"
							type="number"
							min="1"
							max="40"
							disabled={Constant.DEFAULT_AUTO_VERSION}
							id={Ids.PageGenerateVersion}
							value={Constant.DEFAULT_VERSION}
						/>
					</li>
					<li>
						<label for={Ids.PageGenerateMargin}>
							<br-icon set:html={Icons.CheckboxIndeterminateFilled}/>
							Margin
						</label>
						<input
							br:as="textfield"
							type="number"
							min="0"
							id={Ids.PageGenerateMargin}
							value={Constant.DEFAULT_MARGIN}
						/>
					</li>
					<li>
						<label for={Ids.PageGenerateColor}>
							<br-icon set:html={Icons.Color}/>
							Color
						</label>
						<input
							br:as="textfield"
							type="color"
							id={Ids.PageGenerateColor}
							value={Constant.DEFAULT_COLOR}
						/>
					</li>
					<li>
						<label for={Ids.PageGenerateBackgroundColor}>
							<br-icon set:html={Icons.Color}/>
							Background Color
						</label>
						<input
							br:as="textfield"
							type="color"
							id={Ids.PageGenerateBackgroundColor}
							value={Constant.DEFAULT_BACKGROUND_COLOR}
						/>
					</li>
				</ul>
			</details>
		</div>
	</div>
</br-if>