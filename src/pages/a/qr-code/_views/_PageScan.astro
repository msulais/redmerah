---
import * as Icons from '@/enums/icons.enum.js'
import * as Ids from '../_scripts/shared/ids.enum.js'
import * as Pages from '../_scripts/shared/pages.enum.js'
import * as Styles from '../_styles/styles.enum.js'
---

<br-if
	br:query={`page=${Pages.Scan}`}
	br:animation-for={Ids.PageScan}
	br:animation-start-duration="500"
	br:animation-start-keyframes={JSON.stringify({
		opacity: [0, 1],
		scale: [.9, 1]
	})}>
	<div class={[Styles.Page, Styles.PageScan].join(' ')} id={Ids.PageScan}>
		<img src="#" alt="Qr code image" id={Ids.PageScanPreview}/>
		<div>
			<ul>
				<li><button
					br:variant="filled"
					id={Ids.PageScanInput}>
					<br-icon set:html={Icons.ScanText}/>
					Scan QR Code
				</button></li>
				<li><button br:variant="tonal" id={Ids.PageScanCopy} disabled>
					<br-icon set:html={Icons.Copy}/>
					Copy
				</button></li>
			</ul>
			<textarea
				rows="5"
				br:as="textfield"
				readonly
				id={Ids.PageScanOutput}
			></textarea>
		</div>
	</div>
</br-if>